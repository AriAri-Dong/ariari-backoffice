<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ariari.ariari.domain.admin.dataops.DataopsMapper">
    <select id="findIdsForTargetTable" resultType="map">
        SELECT ${id}, deleted_date_time
        FROM ${table}
        <where>
            deleted_date_time IS NULL
            <if test="filter != null and keyword != null">
                AND ${filter} LIKE CONCAT('%', #{keyword}, '%')
            </if>
        </where>
        ORDER BY ${id} DESC
        LIMIT #{size} OFFSET #{offset}
    </select>

    <select id="findIdsForTargetTableWithoutSoftDelete" resultType="map">
        SELECT ${id}
        FROM ${table}
        <where>
            <if test="filter != null and keyword != null">
                ${filter} LIKE CONCAT('%', #{keyword}, '%')
            </if>
        </where>
        ORDER BY ${id} DESC
        LIMIT #{size} OFFSET #{offset}
    </select>

    <select id="countTotalForTargetTable" resultType="int">
        SELECT COUNT(*)
        FROM ${table}
        <where>
            deleted_date_time IS NULL
            <if test="filter != null and keyword != null">
                AND ${filter} LIKE CONCAT('%', #{keyword}, '%')
            </if>
        </where>
    </select>

    <select id="countTotalForTargetTableWithoutSoftDelete" resultType="int">
        SELECT COUNT(*)
        FROM ${table}
        <where>
            <if test="filter != null and keyword != null">
                ${filter} LIKE CONCAT('%', #{keyword}, '%')
            </if>
        </where>
    </select>

    <select id="getDetailDataById" resultType="map">
        SELECT *
        FROM ${table}
        WHERE ${idColumn} = #{dataId}
    </select>
</mapper>